# Copy to .env (same folder) and fill in your ABA PayWay sandbox credentials. Never commit .env.
ABA_MERCHANT_ID=
ABA_API_KEY=
# Public URL of /api/v1/payments/aba/callback (e.g. an ngrok URL when running locally)
ABA_RETURN_URL=
ABA_CONTINUE_SUCCESS_URL=
# RSA public key ABA gives you for the Refund API (one line, PEM header optional). Empty = refunds wait.
ABA_RSA_PUBLIC_KEY=
# Optional: look of the QR image from the QR API
ABA_QR_TEMPLATE=template3_color

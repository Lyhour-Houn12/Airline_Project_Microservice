# Local development settings. Use unique generated secrets; never commit a populated .env file.
DB_USERNAME=postgres
DB_PASSWORD=replace-me
JWT_SECRET=generate-a-unique-random-secret-of-at-least-32-bytes
# Email. MAIL_ENABLED=false prints sign-up / reset codes in the log instead of sending them.
# Gmail: MAIL_USERNAME = your Gmail address, MAIL_PASSWORD = an app password (Google Account ->
# Security -> 2-Step Verification -> App passwords), not your normal password.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_FROM=
MAIL_USERNAME=
MAIL_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SECURITY_LOG_LEVEL=INFO
